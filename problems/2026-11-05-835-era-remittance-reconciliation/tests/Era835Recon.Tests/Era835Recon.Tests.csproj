<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Test project with no NuGet dependencies: tests are plain [Fact] methods discovered by a
    small runner (TestRunner.cs), so the suite runs on a bare .NET 8 SDK with no package feed.
    Run with: dotnet run, project tests/Era835Recon.Tests
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Era835Recon.Core\Era835Recon.Core.csproj" />
  </ItemGroup>

</Project>
