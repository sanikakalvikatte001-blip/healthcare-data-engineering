{
  "name": "tr_um_daily",
  "properties": {
    "type": "ScheduleTrigger",
    "description": "Daily incremental load just after midnight Eastern; dbt runs at the end of the pipeline.",
    "runtimeState": "Started",
    "typeProperties": {
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "startTime": "2026-10-15T00:00:00",
        "timeZone": "Eastern Standard Time",
        "schedule": { "hours": [0], "minutes": [5] }
      }
    },
    "pipelines": [
      {
        "pipelineReference": { "referenceName": "pl_um_incremental_to_snowflake", "type": "PipelineReference" },
        "parameters": { "overlapMinutes": 60 }
      }
    ]
  }
}
